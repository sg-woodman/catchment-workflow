# Rerun watershed delineation for a single site ----
# Use after manually editing pour_point_snapped.shp in QGIS to correct a
# misaligned pour point. Redoes watershed delineation, polygon conversion,
# raster clipping, and flowline clipping — Steps 3-8 of delineate_site().
#
# Does NOT rewrite pour_point.shp or rerun the snapping step — it uses the
# manually-edited pour_point_snapped.shp directly.
#
# Workflow:
#   1. Edit output/<site_id>/pour_point_snapped.shp in QGIS and save
#   2. Run rerun_site_watershed("site_id", sites, group_manifest)
#   3. Re-inspect catchment.gpkg in QGIS
#
# @param site_id        Character. Site identifier
# @param sites          Validated sites tibble from validate_sites()
# @param group_manifest sf tibble from build_group_manifest()
# @param output_dir     Character. Root output directory
# @param min_cells      Integer. Minimum cells threshold for flagging.
#                        Default 10.
#
# @return Single-row tibble with delineation result for this site
rerun_site_watershed <- function(
  site_id,
  sites,
  group_manifest,
  output_dir,
  min_cells = 10
) {
  site_dir <- site_output_dir(output_dir, site_id)
  snapped_shp <- fs::path(site_dir, "pour_point_snapped.shp")

  if (!fs::file_exists(snapped_shp)) {
    cw_abort(glue::glue(
      "Site '{site_id}': pour_point_snapped.shp not found at {site_dir}. ",
      "Has this site been delineated yet?"
    ))
  }

  # Identify the site's group and load group rasters
  site <- dplyr::filter(sites, site_id == !!site_id)
  if (nrow(site) == 0) {
    cw_abort(glue::glue("Site '{site_id}' not found in sites tibble."))
  }

  grp <- site$group_id[1]
  grp_manifest <- dplyr::filter(group_manifest, group_id == grp)
  grp_cache <- grp_manifest$cache_dir

  cw_inform(glue::glue(
    "Site '{site_id}': rerunning watershed delineation with edited pour point..."
  ))

  group_rasters <- load_group_rasters(grp_cache, grp)

  tryCatch(
    {
      # -- Step 3: Delineate watershed from edited pour point ----------------
      watershed_tif <- delineate_watershed(
        snapped_shp = snapped_shp,
        flow_pointer = group_rasters$flow_pointer,
        site_dir = site_dir,
        site_id = site_id
      )

      # -- Step 4: Convert watershed raster to polygon -----------------------
      catchment_sf <- watershed_to_polygon(
        watershed_tif = watershed_tif,
        site_dir = site_dir,
        site_id = site_id
      )

      # Count cells for size check
      watershed_rast <- terra::rast(watershed_tif)
      n_cells <- sum(terra::values(watershed_rast) == 1, na.rm = TRUE)
      res_m <- terra::res(group_rasters$flow_accum)[1]
      km2 <- round((n_cells * res_m^2) / 1e6, 4)

      flagged <- n_cells < min_cells
      flag_reason <- if (flagged) {
        glue::glue(
          "catchment is only {n_cells} cells ({km2} km2) — ",
          "pour point may have snapped to wrong location"
        )
      } else {
        NA_character_
      }

      if (flagged) {
        cw_warn(glue::glue("Site '{site_id}': {flag_reason}"))
      } else {
        cw_inform(glue::glue(
          "Site '{site_id}': catchment = {n_cells} cells ({km2} km2)."
        ))
      }

      catchment_sf <- catchment_sf |>
        dplyr::mutate(
          site_id = site_id,
          n_cells = n_cells,
          area_km2 = km2,
          flagged = flagged
        )

      # -- Step 5: Update snapped pour point output ---------------------------
      snapped_sf <- sf::st_read(snapped_shp, quiet = TRUE) |>
        sf::st_transform(3979) |>
        dplyr::mutate(site_id = site_id)

      sf::st_write(
        snapped_sf,
        fs::path(site_dir, "pour_point.gpkg"),
        delete_dsn = TRUE,
        quiet = TRUE
      )

      # -- Step 6: Overwrite catchment polygon --------------------------------
      sf::st_write(
        catchment_sf,
        fs::path(site_dir, "catchment.gpkg"),
        delete_dsn = TRUE,
        quiet = TRUE
      )

      # -- Step 7: Re-clip and mask group rasters to new catchment ------------
      # Force overwrite — cache_exists() check inside clip_rasters_to_catchment
      # would otherwise skip these since they already exist from the first run
      raster_files <- fs::path(site_dir, paste0(names(group_rasters), ".tif"))
      fs::file_delete(raster_files[fs::file_exists(raster_files)])

      clip_rasters_to_catchment(
        catchment_sf = catchment_sf,
        group_rasters = group_rasters,
        site_dir = site_dir,
        site_id = site_id
      )

      # -- Step 8: Re-clip NHN flowlines to new catchment ---------------------
      streams_path <- fs::path(site_dir, "streams.gpkg")
      if (fs::file_exists(streams_path)) {
        fs::file_delete(streams_path)
      }

      clip_flowlines_to_catchment(
        catchment_sf = catchment_sf,
        flowlines_path = fs::path(grp_cache, "flowlines.gpkg"),
        site_dir = site_dir,
        site_id = site_id
      )

      cw_inform(glue::glue("Site '{site_id}': rerun complete."))

      tibble::tibble(
        site_id = site_id,
        status = "rerun success",
        catchment_cells = n_cells,
        catchment_km2 = km2,
        flagged = flagged,
        flag_reason = flag_reason
      )
    },
    error = function(e) {
      cw_warn(glue::glue("Site '{site_id}': rerun failed — {e$message}"))

      tibble::tibble(
        site_id = site_id,
        status = paste("rerun failed:", e$message),
        catchment_cells = NA_integer_,
        catchment_km2 = NA_real_,
        flagged = TRUE,
        flag_reason = e$message
      )
    }
  )
}

# Usage:
rerun_site_watershed("SN3_UP", sites, group_manifest, output_dir)
